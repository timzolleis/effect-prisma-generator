datasource db {
  provider = "sqlite"
}

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["typedSql"]
}

generator effect {
  provider         = "node ../dist/index.js"
  output           = "./generated/effect.ts"
  clientImportPath = "./client"
  schemaOutput     = "./generated/schemas.ts"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id       Int     @id @default(autoincrement())
  title    String
  content  String?
  authorId Int
  author   User    @relation(fields: [authorId], references: [id])
}

// A model with a required `Unsupported(...)` field. Prisma omits its
// create/createMany/createManyAndReturn/upsert operations (and their *Args
// types), so the generator must omit those operations too while keeping the
// rest of the model in the service.
model Embedding {
  id     Int                   @id @default(autoincrement())
  vector Unsupported("vector")
}

// Every scalar type sqlite supports, for row-schema decode coverage against
// real client return values (enums are postgres-only — see the
// postgres-schemas fixture).
model Scalars {
  id      Int      @id @default(autoincrement())
  text    String
  flag    Boolean
  num     Float
  dec     Decimal
  big     BigInt
  bytes   Bytes
  json    Json
  at      DateTime @default(now())
  optText String?
}

// snake_case model name: regression coverage for first-letter-capitalized Prisma types
model user_account {
  id    Int    @id @default(autoincrement())
  email String @unique
  score Int    @default(0)
}
